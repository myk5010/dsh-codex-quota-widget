{
  "name": "dsh-codex-quota-widget",
  "version": "1.0.4",
  "private": true,
  "description": "DSH Web Codex subscription quota badge with authenticated host-side polling, shared cache and safe OAuth refresh.",
  "type": "module",
  "main": "host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host.js",
    "monitor.js",
    "cordis.patch.yml",
    "lib/client.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/device-code-login.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "npm run build && node tests/browser.mjs",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "playwright": "1.61.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
